# Copia este archivo a .env.dev (no se versiona) y completa los valores.
# Solo para desarrollo local: usado por `npm run dev:local`.
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:8080
DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/powerbuilding_dev
JWT_SECRET=cambiar_por_un_secret_local
JWT_EXPIRES_IN=7d
# Correo (Bloque 5). En local deja EMAIL_PROVIDER=simulado: no envia nada, solo registra.
# En Railway estas mismas variables se configuran en el servicio (Variables); no se suben a git.
EMAIL_PROVIDER=simulado
EMAIL_API_KEY=
EMAIL_FROM=correo-verificado@tu-dominio.cl
EMAIL_FROM_NAME=Powerbuilding.gym
# Jobs de recordatorios/vencimientos: "off" los desactiva. REMINDER_HOURS = antelacion del recordatorio.
NOTIF_JOBS=on
REMINDER_HOURS=2
# Evita que el backend cargue web/backend/.env (produccion). No quitar.
PB_LOCAL=1
